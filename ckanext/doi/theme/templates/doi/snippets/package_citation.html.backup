{#
Renders a citation for a package
#}

{% block citation %}
<section class="additional-info">

    <h3>{{ _('Cite this as') }}</h3>

    <div class="citation">
        <div id="citation-string" class="citation-string">
            {# --- 1) Custom citation, if available -------------------------------- #}
            {% if pkg_dict.get('custom_citation') %}
                {{ pkg_dict.get('custom_citation')|safe }}

                {# Show custom DOI link, if available #}
                {% if pkg_dict.get('custom_doi') %}
                    {% set doi_link = pkg_dict['custom_doi'] %}
                    &nbsp;<a href="{{ doi_link }}" target="_blank">{{ doi_link }}</a>
                {% endif %}

            {# --- 2) Default generated citation ------------------------------------ #}
            {% else %}
                {% if pkg_dict.get('author') and pkg_dict.get('title') %}
                    {{ pkg_dict.get('author') }} ({{ h.package_get_year(pkg_dict) }}). 
                    <i>{{ pkg_dict.get('title') }}</i> [Data set]. 
                    {{ pkg_dict.get('doi_publisher', '') }}
                    {% if pkg_dict['doi_status'] %}.{% endif %}

                    {# Link to institutional DOI, if available #}
                    {% if pkg_dict.get('doi') %}
                        {% set doi_link = 'https://doi.org/' + pkg_dict['doi'] %}
                        <a href="{{ doi_link }}" target="_blank">{{ doi_link }}</a>
                    {% endif %}
                {% else %}
                    <em>{{ _('Citation information not available') }}</em>
                {% endif %}
            {% endif %}
        </div>

        {# --- Institutional DOI status (unchanged) -------------------------- #}
        <div id="citation-status">
            {% if not pkg_dict['doi_status'] %}
                <div>
                    <span class="dataset-private label label-inverse"
                          title="{{ _('This DOI has not yet been published') }}">
                        <i class="fa fa-lock"></i> {{ _('Private DOI') }}
                    </span>
                    <small>
                        <i class="fa fa-exclamation-sign"></i>
                        <strong>{{ _('This DOI is not yet resolvable.') }}</strong>
                    </small>
                </div>
                <div>
                    <small>
                        {{ _('It is available for use in manuscripts, and will be published when the Dataset is made public or updated.') }}
                    </small>
                </div>
            {% else %}
                <div>
                    <small>
                        {{ _('Retrieved:') }} {{ h.render_datetime(h.now(), date_format='%H:%M %d %b %Y (%Z)') }}
                    </small>
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
